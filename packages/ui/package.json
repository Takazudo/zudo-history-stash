{
  "name": "@takazudo/zudo-history-stash-ui",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/styles.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "styles/tokens.example.css",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup && node scripts/build-css.mjs",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "typecheck": "tsc --noEmit && pnpm check:examples",
    "check:examples": "tsc -p examples-check/tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:tokens": "design-token-lint && node scripts/lint-raw-px.mjs",
    "lint:pkg": "pnpm dlx publint@0.3.12 && pnpm dlx @arethetypeswrong/cli@0.18.5 --pack . --profile esm-only --exclude-entrypoints ./styles.css",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@takazudo/zudo-history-stash": "workspace:*",
    "@takazudo/zudo-history-stash-core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@takazudo/zudo-design-token-lint": "^2.1.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^28.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
