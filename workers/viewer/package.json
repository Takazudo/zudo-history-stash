{
  "name": "zudo-history-stash-viewer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && wrangler deploy --dry-run --outdir=.wrangler --env=\"\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:tokens": "design-token-lint",
    "e2e": "playwright test",
    "e2e:list": "bash scripts/check-e2e-collection.sh",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.0",
    "@takazudo/zudo-history-stash": "workspace:*",
    "@takazudo/zudo-history-stash-core": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "tailwindcss": "^4.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@takazudo/zudo-design-token-lint": "^2.1.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^28.0.0",
    "vite": "^7.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
