# Local-only convention used by dev:full, the seed, contract tests, and @live Playwright lane.
STASH_ADMIN_TOKEN=dev-admin-token
# Byte policies are pinned in wrangler.toml. Override them here only for deliberate local testing.
# Enabling MAX_FILE_BYTES=1073741824 also requires MAX_RESERVED_UPLOAD_BYTES>=1073741824.
