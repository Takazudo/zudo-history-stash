{
  "name": "zudo-history-stash-doc",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "pnpm copy:openapi",
    "dev": "run-p dev:zfb dev:history",
    "prebuild": "pnpm copy:openapi",
    "build": "zfb build",
    "preview": "zfb preview",
    "check": "zfb check",
    "b4push": "bash scripts/run-b4push.sh",
    "test": "node --test scripts/*.test.mjs plugins/*.test.mjs",
    "test:tooling": "node --test scripts/*.test.mjs plugins/*.test.mjs",
    "format:md": "pnpm -w exec mdx-formatter --write --config .mdx-formatter.json \"doc/src/content/**/*.{md,mdx}\"",
    "format:md:check": "pnpm -w exec mdx-formatter --check --config .mdx-formatter.json \"doc/src/content/**/*.{md,mdx}\"",
    "check:template-drift": "node scripts/check-template-drift.mjs",
    "check:pin-parity": "node scripts/check-pin-parity.mjs",
    "check:wrangler-pin": "node scripts/check-wrangler-pin.mjs",
    "check:contract": "node scripts/check-contract.mjs --locale en",
    "check:versions": "node scripts/check-versions.mjs",
    "check:examples": "tsc --noEmit -p examples-check/tsconfig.json && node scripts/check-examples.mjs",
    "write:examples-manifest": "node scripts/check-examples.mjs --write",
    "copy:openapi": "node scripts/copy-openapi.mjs",
    "check:locale-parity": "bash -c 'if [[ -f scripts/check-locale-parity.mjs ]]; then node scripts/check-locale-parity.mjs; else echo \"SKIP check:locale-parity pending #168\"; fi'",
    "check:html": "html-validate \"dist/**/*.html\"",
    "check:links": "node scripts/check-links.js --strict-broken --strict-absolute --strict-anchors --allowlist=.check-links-allowlist",
    "generate:ogp": "node scripts/generate-ogp.mjs",
    "dev:zfb": "zfb dev",
    "dev:zfb:network": "zfb dev --host 0.0.0.0",
    "dev:network": "run-p dev:zfb:network dev:history",
    "dev:history": "doc-history-server --port 4322 --content-dir src/content/docs --locale ja:src/content/docs-ja",
    "setup:doc-skill": "bash scripts/setup-doc-skill.sh zudo-history-stash-wisdom",
    "setup:doc-skill-silent": "bash scripts/setup-doc-skill.sh --silent zudo-history-stash-wisdom",
    "setup:doc-skill:claude": "bash scripts/setup-doc-skill.sh --target claude zudo-history-stash-wisdom",
    "setup:doc-skill:codex": "bash scripts/setup-doc-skill.sh --target codex zudo-history-stash-wisdom",
    "setup:doc-skill:both": "bash scripts/setup-doc-skill.sh --target both zudo-history-stash-wisdom"
  },
  "dependencies": {
    "@takazudo/zfb": "2.12.0",
    "@takazudo/zfb-runtime": "2.12.0",
    "@takazudo/zfb-md-wasm": "2.12.0",
    "@takazudo/zudo-doc": "5.13.0",
    "zod": "^4.3.6",
    "preact": "^10.29.1",
    "preact-render-to-string": "^6.6.6",
    "katex": "^0.16.38",
    "diff": "^8.0.3",
    "@takazudo/zdtp": "0.4.12",
    "minisearch": "^7.2.0",
    "@takazudo/zudo-doc-history-server": "5.13.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@takazudo/zfb-adapter-cloudflare": "2.12.0",
    "create-zudo-doc": "5.13.0",
    "html-validate": "10.9.0",
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0",
    "pagefind": "^1.4.0",
    "npm-run-all2": "^7.0.2",
    "wrangler": "4.125.0"
  }
}
